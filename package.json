{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.6.0",
  "description": "Unofficial desktop shell for DeepSeek Harness: a native window around the local dsh web server.",
  "license": "MIT",
  "author": {
    "name": "Jin-wen-jie",
    "url": "https://github.com/Jin-wen-jie"
  },
  "homepage": "https://github.com/Jin-wen-jie/DeepSeek-Harness-Desktop-App",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jin-wen-jie/DeepSeek-Harness-Desktop-App.git"
  },
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/patch-dsh.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win && node scripts/verify-packaged.mjs",
    "dist:linux": "npm run build && electron-builder --linux && node scripts/verify-packaged.mjs release/linux-unpacked/resources/app",
    "dist:mac": "npm run build && electron-builder --mac && node scripts/verify-packaged.mjs release/mac/DeepSeek Harness.app/Contents/Resources/app",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run build && npm run smoke"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "^0.1.0-rc.6",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "~7.0.2"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.0-rc.6": true,
    "@google/genai@1.52.0": true,
    "electron-winstaller@5.4.0": true,
    "koffi@3.1.5": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.5": true
  }
}
